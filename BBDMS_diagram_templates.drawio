value="[Entity 4]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="420" width="150" height="50" as="geometry"/></mxCell><mxCell id="c15" value="[input data]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c14" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="[output data]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c4" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="[Entity 5]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="350" y="30" width="150" height="50" as="geometry"/></mxCell><mxCell id="c18" value="[input data]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c17" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="[output data]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c4" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="4 DFD Level 1" id="p4"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Level 1 DFD - [System Name]" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="c3" value="TEMPLATE HINT (delete before submitting)&lt;br&gt;Break the single process into 3-5 numbered sub-processes (1.0, 2.0...). Add data stores (D1, D2...). Rule: data never flows entity-&gt;store or store-&gt;store directly; a process must sit between." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;size=14;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="20" width="250" height="150" as="geometry"/></mxCell><mxCell id="c4" value="[Entity 1]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="140" height="50" as="geometry"/></mxCell><mxCell id="c5" value="[Entity 2]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="780" y="80" width="140" height="50" as="geometry"/></mxCell><mxCell id="c6" value="[Entity 3]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="780" y="420" width="140" height="50" as="geometry"/></mxCell><mxCell id="c7" value="1.0&lt;br&gt;[Process 1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=15;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="170" height="70" as="geometry"/></mxCell><mxCell id="c8" value="2.0&lt;br&gt;[Process 2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=15;" vertex="1" parent="1"><mxGeometry x="330" y="210" width="170" height="70" as="geometry"/></mxCell><mxCell id="c9" value="3.0&lt;br&gt;[Process 3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=15;" vertex="1" parent="1"><mxGeometry x="580" y="300" width="170" height="70" as="geometry"/></mxCell><mxCell id="c10" value="D1  [Data store 1]" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="200" height="50" as="geometry"/></mxCell><mxCell id="c11" value="D2  [