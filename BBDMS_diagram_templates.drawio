<mxfile host="app.diagrams.net"><diagram name="1 Use Case" id="p1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Use Case Diagram - [System Name]" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="c3" value="TEMPLATE HINT (delete before submitting)&lt;br&gt;Actors outside the box; use cases (ovals) inside. Plain line = association. Dashed arrow = include/extend (extend arrow points to the BASE use case). Rename everything." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;size=14;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="20" width="250" height="150" as="geometry"/></mxCell><mxCell id="c4" value="[System Name]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="460" height="500" as="geometry"/></mxCell><mxCell id="c5" value="Actor 1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="30" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Actor 2" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="70" y="380" width="30" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Actor 3&lt;br&gt;(external system)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="740" y="260" width="30" height="60" as="geometry"/></mxCell><mxCell id="c8" value="Use case 1" style="ellipse;whiteSpace=wra